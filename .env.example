# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave pública (anon / publishable). NUNCA coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Notificações de novos agendamentos (Web Push). Gere um par com:
#   npx web-push generate-vapid-keys
# A pública pode aparecer no navegador; a privada fica só na hospedagem.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contato do site para o serviço de push (mailto: ou https://)
VAPID_SUBJECT=
